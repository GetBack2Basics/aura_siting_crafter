  "cleaning_rules": {
    "st_make_valid": true,
    "drop_null_geometries": true,
    "clean_coordinates": true
  },
  "storage": {
    "table_name": "nsw_renewable_energy_zones_rez",
    "format": "havasu.iceberg",
    "partition_by": "rez_name"
  },
  "audit": {
    "cadence": "Continuous Update",
    "statutory_act": "Electricity Infrastructure Investment Act 2020",
    "is_raw_unchanged": false
  }
}
