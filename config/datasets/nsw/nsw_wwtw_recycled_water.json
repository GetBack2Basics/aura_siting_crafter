  "cleaning_rules": {
    "st_make_valid": true,
    "drop_null_geometries": true,
    "clean_coordinates": true
  },
  "storage": {
    "table_name": "nsw_wwtw_recycled_water",
    "format": "havasu.iceberg",
    "partition_by": "operator"
  },
  "audit": {
    "cadence": "Quarterly Update",
    "statutory_act": "Water Industry Competition Act 2006",
    "is_raw_unchanged": false
  }
}
