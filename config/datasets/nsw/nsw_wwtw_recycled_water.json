{
  "dataset_key": "nsw_wwtw_recycled_water",
  "dataset_name": "Wastewater Treatment Plants (WWTW) & Recycled Effluent Distribution",
  "source_agency": "Sydney Water, Hunter Water & Regional Local Water Utilities",
  "portal": "NSW Spatial Services / Water Utility APIs",
  "portal_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Features_of_Interest_Category/FeatureServer",
  "service_type": "arcgis_featureserver",
