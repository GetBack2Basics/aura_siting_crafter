{
  "project_name": "AURA National Siting Crafter — GeoLibre WebGIS",
  "version": "2.5.0",
  "storage_root": "s3://wherobots-user-storage/aura_siting",
  "default_view": {
    "center": [133.7751, -25.2744],
    "zoom": 4.5,
    "pitch": 0,
    "bearing": 0
  },
  "basemap": {
    "style": "https://tiles.openfreemap.org/styles/liberty",
    "theme": "dark",
    "background_color": "#0a0f1d"
  },
  "theme_tokens": {
    "bg_primary": "#0a0f1d",
    "bg_secondary": "#131a2c",
    "card_bg": "rgba(19, 26, 44, 0.75)",
    "border_color": "rgba(59, 130, 246, 0.2)",
    "accent_blue": "#3b82f6",
    "accent_cyan": "#06b6d4",
    "accent_green": "#10b981",
    "accent_amber": "#f59e0b",
    "accent_rose": "#f43f5e"
  },
  "persona_presets": {
    "general_public": {
      "name": "General Public",
      "badge_color": "#38bdf8",
      "weights": { "power": 40, "sensitive": 25, "water": 20, "size": 15, "target_size_ha": 15 },
      "tsf_excluded": true
    },
    "planner": {
      "name": "Planner",
      "badge_color": "#38bdf8",
      "weights": { "power": 40, "sensitive": 25, "water": 20, "size": 15, "target_size_ha": 15 },
      "tsf_excluded": true
    },
    "regulator": {
      "name": "Regulator",
      "badge_color": "#fbbf24",
      "weights": { "power": 40, "sensitive": 25, "water": 25, "size": 10, "target_size_ha": 15 },
      "tsf_excluded": true
    },
    "developer": {
      "name": "Developer",
      "badge_color": "#34d399",
      "weights": { "power": 50, "sensitive": 15, "water": 15, "size": 20, "target_size_ha": 20 },
      "tsf_excluded": false
    },
    "community": {
      "name": "Community",
      "badge_color": "#c084fc",
      "weights": { "power": 25, "sensitive": 40, "water": 25, "size": 10, "target_size_ha": 10 },
      "tsf_excluded": true
    }
  },
  "categories": [
    {
      "id": "candidates",
      "name": "🎯 Candidate Hubs & Siting Scorecards",
      "description": "National suitability assessment candidate sites with composite multi-criteria evaluation scores",
      "expanded_by_default": true,
      "layers": [
        {
          "id": "national_candidates",
          "name": "National Siting Candidate Hubs",
          "type": "circle",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/candidates/datacenter_candidates_national.parquet",
          "stream_url": "/runner/attachments/candidates.json",
          "visible": true,
          "paint": {
            "circle-radius": [
              "interpolate",
              ["linear"],
              ["get", "suitability_score"],
              0.5, 10,
              1.0, 16
            ],
            "circle-color": [
              "step",
              ["get", "suitability_score"],
              "#ef4444",
              0.70, "#f59e0b",
              0.85, "#10b981"
            ],
            "circle-stroke-color": "#ffffff",
            "circle-stroke-width": 1.5,
            "circle-opacity": 0.88
          },
          "popup_properties": [
            "town_name",
            "state_name",
            "suitability_score",
            "area_ha",
            "dist_to_substation_km",
            "dist_to_wwtw_km",
            "dist_to_sensitive_km",
            "slope_pct",
            "pumped_hydro_capacity_mwh"
          ]
        }
      ]
    },
    {
      "id": "hazards",
      "name": "🛡️ Statutory Multi-Hazard Resilience Overlays",
      "description": "Statutory Australian multi-hazard spatial overlays (Flood, Seismic PGA, Cyclone Wind, Landslide, Bushfire)",
      "expanded_by_default": true,
      "layers": [
        {
          "id": "national_seismic_hazard_nsha",
          "name": "GA NSHA 2018 Seismic PGA Contours",
          "type": "line",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/hazards/national_seismic_hazard_nsha.parquet",
          "stream_url": "https://services.ga.gov.au/gis/rest/services/National_Seismic_Hazard_Assessment_2018/MapServer/0/query",
          "visible": false,
          "paint": {
            "line-color": "#f59e0b",
            "line-width": 1.5
          },
          "popup_properties": ["pga_value", "site_subsoil_class", "zone_id"]
        },
        {
          "id": "national_cyclone_hazard_tcha",
          "name": "GA TCHA 2018 Cyclone Wind Regions",
          "type": "fill",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/hazards/national_cyclone_hazard_tcha.parquet",
          "stream_url": "https://services.ga.gov.au/gis/rest/services/Tropical_Cyclone_Hazard_Assessment_2018/MapServer/0/query",
          "visible": false,
          "paint": {
            "fill-color": "#38bdf8",
            "fill-opacity": 0.15,
            "fill-outline-color": "#38bdf8"
          },
          "popup_properties": ["wind_region", "design_wind_speed_ms"]
        },
        {
          "id": "nsw_coastal_inundation_hazard",
          "name": "1% AEP Flood & Coastal Inundation",
          "type": "circle",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/hazards/nsw_coastal_inundation_hazard.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Features_of_Interest_Category/FeatureServer/2/query",
          "visible": false,
          "paint": {
            "circle-color": "#06b6d4",
            "circle-radius": 4.0
          },
          "popup_properties": ["flood_depth_m", "inundation_type"]
        },
        {
          "id": "landslide_susceptibility",
          "name": "AGS Landslide & Slope Susceptibility",
          "type": "fill",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/hazards/nsw_landslide_susceptibility.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Land_Parcel_Property_Theme/FeatureServer/7/query",
          "visible": false,
          "paint": {
            "fill-color": "#a855f7",
            "fill-opacity": 0.15,
            "fill-outline-color": "#a855f7"
          },
          "popup_properties": ["susceptibility_class", "slope_pct"]
        }
      ]
    },
    {
      "id": "cadastre",
      "name": "📐 Cadastre & Statistical Boundaries",
      "description": "National cadastral lot fabric and ABS 2021 census statistical areas",
      "expanded_by_default": false,
      "layers": [
        {
          "id": "abs_meshblocks",
          "name": "ABS 2021 Meshblocks & UCL",
          "type": "fill",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/cadastre/abs_meshblocks_2021.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Land_Parcel_Property_Theme/MapServer/0/query",
          "visible": false,
          "paint": {
            "fill-color": "#94a3b8",
            "fill-opacity": 0.05,
            "fill-outline-color": "#94a3b8"
          },
          "popup_properties": ["mb_code21", "meshblock_category", "state_name", "population"]
        },
        {
          "id": "geoscape_cadastre",
          "name": "Geoscape National Cadastre & G-NAF",
          "type": "fill",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/cadastre/geoscape_cadastre.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Land_Parcel_Property_Theme/MapServer/0/query",
          "minzoom": 12,
          "visible": false,
          "paint": {
            "fill-color": "#64748b",
            "fill-opacity": 0.04,
            "fill-outline-color": "#64748b"
          },
          "popup_properties": ["lot_plan", "cadastre_id", "area_sqm", "locality_name"]
        }
      ]
    },
    {
      "id": "energy",
      "name": "⚡ Energy Grid & Substations",
      "description": "National electricity transmission lines, substations, and high voltage network corridors",
      "expanded_by_default": false,
      "layers": [
        {
          "id": "transmission_lines_interstate",
          "name": "Interstate Transmission Grid (≥275kV)",
          "type": "line",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/energy/national_transmission_grid.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Features_of_Interest_Category/MapServer/6/query",
          "filter": [">=", ["get", "capacity_kv"], 275],
          "visible": false,
          "paint": {
            "line-color": "#38bdf8",
            "line-width": 3.0,
            "line-opacity": 0.95
          },
          "popup_properties": ["line_name", "voltage_kv", "operator", "circuit_type"]
        },
        {
          "id": "transmission_lines_regional",
          "name": "Regional Transmission Grid (132kV-275kV)",
          "type": "line",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/energy/national_transmission_grid.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Features_of_Interest_Category/MapServer/6/query",
          "filter": ["all", [">=", ["get", "capacity_kv"], 132], ["<", ["get", "capacity_kv"], 275]],
          "minzoom": 6,
          "visible": false,
          "paint": {
            "line-color": "#60a5fa",
            "line-width": 2.0,
            "line-opacity": 0.85
          },
          "popup_properties": ["line_name", "voltage_kv", "operator"]
        },
        {
          "id": "substations_terminal",
          "name": "Electrical Substations & Terminal Stations",
          "type": "circle",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/energy/national_substations.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Features_of_Interest_Category/MapServer/6/query",
          "visible": false,
          "paint": {
            "circle-radius": 5.5,
            "circle-color": "#f59e0b",
            "circle-stroke-color": "#0f172a",
            "circle-stroke-width": 1.5
          },
          "popup_properties": ["substation_name", "voltage_kv", "substation_type", "state_name"]
        }
      ]
    },
    {
      "id": "water",
      "name": "💧 Water & Cooling Loops",
      "description": "Recycled water treatment plants, municipal outfalls, and surface water conduits",
      "expanded_by_default": false,
      "layers": [
        {
          "id": "bom_hydro_lines",
          "name": "BoM Surface Water HydroLine & HydroArea",
          "type": "line",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/water/bom_surface_water_wwtw.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Features_of_Interest_Category/MapServer/4/query",
          "visible": false,
          "paint": {
            "line-color": "#06b6d4",
            "line-width": 1.5,
            "line-opacity": 0.85
          },
          "popup_properties": ["feature_name", "strahler_order", "water_type"]
        },
        {
          "id": "recycled_wwtw_plants",
          "name": "Recycled Wastewater Treatment Plants (WWTW)",
          "type": "circle",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/water/recycled_wwtw_plants.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Features_of_Interest_Category/MapServer/4/query",
          "visible": false,
          "paint": {
            "circle-radius": 5.5,
            "circle-color": "#14b8a6",
            "circle-stroke-color": "#ffffff",
            "circle-stroke-width": 1.2
          },
          "popup_properties": ["plant_name", "treatment_level", "capacity_ml_day", "recycled_viable"]
        }
      ]
    },
    {
      "id": "receptors",
      "name": "🛡️ Social & Environmental Receptors",
      "description": "Educational facilities, healthcare hospitals, and heavy transport rail alignments",
      "expanded_by_default": false,
      "layers": [
        {
          "id": "acara_schools",
          "name": "ACARA National Schools (500m Buffer)",
          "type": "circle",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/receptors/acara_national_schools.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Features_of_Interest_Category/MapServer/3/query",
          "visible": false,
          "paint": {
            "circle-radius": 4.5,
            "circle-color": "#a855f7",
            "circle-stroke-color": "#581c87",
            "circle-stroke-width": 1.0
          },
          "popup_properties": ["school_name", "school_type", "sector", "suburb", "state"]
        },
        {
          "id": "nhsd_healthcare",
          "name": "NHSD National Healthcare & Hospitals",
          "type": "circle",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/receptors/nhsd_national_healthcare.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Features_of_Interest_Category/MapServer/2/query",
          "visible": false,
          "paint": {
            "circle-radius": 5.0,
            "circle-color": "#ec4899",
            "circle-stroke-color": "#831843",
            "circle-stroke-width": 1.2
          },
          "popup_properties": ["facility_name", "facility_type", "emergency_dept", "state"]
        },
        {
          "id": "transport_rail",
          "name": "Heavy Freight & Transport Rail Corridors",
          "type": "line",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/transport/nsw_railway_corridors.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Transport_Theme/MapServer/7/query",
          "visible": false,
          "paint": {
            "line-color": "#94a3b8",
            "line-width": 2.0,
            "line-dasharray": [5, 2]
          },
          "popup_properties": ["line_name", "gauge", "freight_access", "track_type"]
        }
      ]
    },
    {
      "id": "environment",
      "name": "🌿 Biodiversity & Bushfire Constraints",
      "description": "High Environmental Value biodiversity zones and statutory Bush Fire Prone Land buffers",
      "expanded_by_default": false,
      "layers": [
        {
          "id": "bionet_biodiversity",
          "name": "NSW SEED & BioNet BV Map / KHIB",
          "type": "fill",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/environment/bionet_biodiversity_khib.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Features_of_Interest_Category/MapServer/5/query",
          "visible": false,
          "paint": {
            "fill-color": "#84cc16",
            "fill-opacity": 0.20,
            "fill-outline-color": "#65a30d"
          },
          "popup_properties": ["habitat_id", "veg_community", "threatened_species", "statutory_status"]
        },
        {
          "id": "rfs_bushfire_bfpl",
          "name": "NSW RFS Bush Fire Prone Land (BFPL)",
          "type": "fill",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/environment/rfs_bushfire_prone_land.parquet",
          "stream_url": "https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Features_of_Interest_Category/MapServer/5/query",
          "visible": false,
          "paint": {
            "fill-color": "#ef4444",
            "fill-opacity": 0.20,
            "fill-outline-color": "#dc2626"
          },
          "popup_properties": ["category", "buffer_m", "vegetation_type", "lga_name"]
        }
      ]
    },
    {
      "id": "micro_siting",
      "name": "🏗️ Precinct Micro-Siting Masterplans",
      "description": "High-precision transformation precinct envelopes, net developable pads, and pipeline easements",
      "expanded_by_default": false,
      "layers": [
        {
          "id": "transformation_boundary",
          "name": "Macquarie Transformation Envelope",
          "type": "line",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/precincts/transformation_boundary.parquet",
          "stream_url": "/runner/attachments/layers/precinct_boundary.json",
          "visible": false,
          "paint": {
            "line-color": "#3b82f6",
            "line-width": 3.0,
            "line-dasharray": [6, 3],
            "line-opacity": 0.95
          },
          "popup_properties": ["precinct_id", "precinct_name", "gross_area_ha", "state", "status"]
        },
        {
          "id": "net_developable_pad",
          "name": "Net Developable Pad Area (59.7 ha)",
          "type": "fill",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/precincts/net_developable_pad_59ha.parquet",
          "stream_url": "/runner/attachments/layers/net_developable.json",
          "visible": false,
          "paint": {
            "fill-color": "#14b8a6",
            "fill-opacity": 0.40,
            "fill-outline-color": "#0d9488"
          },
          "popup_properties": ["pad_zone", "pad_name", "net_developable_area_ha", "slope_grade_pct", "geotechnical_status"]
        },
        {
          "id": "gas_pipeline_corridor",
          "name": "High Pressure Gas Pipeline Corridor (20m APZ)",
          "type": "line",
          "source_type": "geoparquet",
          "s3_path": "s3://wherobots-user-storage/aura_siting/precincts/gas_pipeline_corridor_20m.parquet",
          "stream_url": "/runner/attachments/layers/pipeline_corridors.json",
          "visible": false,
          "paint": {
            "line-color": "#f97316",
            "line-width": 3.0,
            "line-dasharray": [4, 2],
            "line-opacity": 0.90
          },
          "popup_properties": ["corridor_id", "infrastructure_type", "buffer_setback_m", "operator"]
        }
      ]
    }
  ]
}
